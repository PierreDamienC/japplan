# Copier ce fichier en `.env.local` (déjà ignoré par git via le pattern `*.local`)
# et renseigner les valeurs créées dans Google Cloud Console — voir le plan
# OAuth pour la procédure complète.

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PICKER_API_KEY=
# Numéro de projet Google Cloud (PAS l'ID projet) — visible sur la page
# d'accueil du projet dans la console, ou IAM & Admin > Paramètres.
VITE_GOOGLE_PROJECT_NUMBER=
